# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Only the PUBLIC anon key belongs here. Never put the service-role key in
# any VITE_ variable: everything prefixed VITE_ is shipped to the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Allow new visitors to create their own company from the sign-up page.
# Set to false once your company is set up; team members are then invited by the owner.
VITE_ALLOW_SIGNUP=true
